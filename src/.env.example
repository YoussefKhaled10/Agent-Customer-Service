# ==================================================
# Application Settings
# ==================================================
APP_NAME=PharmaCare AI Sales & Customer Service Agent
APP_VERSION=1.0.0
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=5001
DEBUG=true
SECRET_KEY=
# ==================================================
# PostgreSQL Settings
# ==================================================
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

POSTGRES_URL=


# ==================================================
# Cohere Embedding Settings
# ==================================================
EMBEDDING_BACKEND=cohere
COHERE_API_KEY=
COHERE_API_BASE_URL=https://api.cohere.com/v2

DOCUMENT_CHUNKING_PROVIDER=gemini
DOCUMENT_CHUNKING_MODEL=gemini-3.5-flash-lite

MODEL_CHUNK_PLANNER_WINDOW=4
MODEL_CHUNK_PLANNER_CONCURRENCY=2

EMBEDDING_MODEL=embed-multilingual-light-v3.0
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=16
EMBEDDING_NORMALIZE=true
EMBEDDING_TYPE=float

# Cohere search input types
EMBEDDING_DOCUMENT_INPUT_TYPE=search_document
EMBEDDING_QUERY_INPUT_TYPE=search_query

# ==================================================
# PDF Ingestion Settings
# ==================================================
PDF_MAX_FILE_SIZE_MB=20
PDF_MAX_PAGES=300
PDF_MIN_EXTRACTED_CHARACTERS=50


MODEL_CHUNK_TARGET_TOKENS=400
MODEL_CHUNK_MAX_TOKENS=600
MODEL_CHUNK_INCLUDE_CAPTIONS=true
MODEL_CHUNK_INCLUDE_TABLES=true
MODEL_CHUNK_INCLUDE_REFERENCES=false
MODEL_CHUNK_MAX_BLOCKS_PER_REQUEST=25
MODEL_CHUNK_TIMEOUT_SECONDS=180


MODEL_CHUNK_BATCH_OVERLAP_BLOCKS=2
MODEL_CHUNK_MAX_RETRIES=0


LAYOUT_BLOCK_TARGET_TOKENS=160
LAYOUT_BLOCK_MAX_TOKENS=220

QUERY_REWRITE_PROVIDER=groq
RETRIEVAL_QUERY_REWRITE_MODEL=openai/gpt-oss-20b
RERANK_MODEL=rerank-v3.5

ANSWER_PROVIDER=groq
GROQ_API_KEY=
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_ANSWER_MODEL=gemini-3.6-flash


# Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60


AGENT_PROVIDER=groq
AGENT_MODEL=openai/gpt-oss-120b
AGENT_MAX_TOOL_ITERATIONS=5